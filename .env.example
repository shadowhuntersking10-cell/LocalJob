# ──────────────────────────────────────────────────────────────────────────────
#  LocalJob — environment configuration
#  Copy to .env and adjust.  `python main.py` reads this file automatically.
# ──────────────────────────────────────────────────────────────────────────────

# Telegram bot
BOT_TOKEN=123456:ABC-your-token-from-BotFather
BOT_USERNAME=LocalJobUzBot
# Telegram numeric ids that get the admin panel in the bot and in the WebApp
ADMIN_IDS=123456789

# Public URL of the deployed platform (used for the WebApp button).
# Leave empty to use http://localhost:8000 during local development.
PUBLIC_URL=

# Server
HOST=0.0.0.0
PORT=8000

# MySQL (recommended).  If the server is unreachable, LocalJob falls back to SQLite
# so `python main.py` always starts.
DB_ENGINE=auto
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=localjob
DB_PASSWORD=localjob
DB_NAME=localjob
# Or provide a full URL instead of the fields above:
# DATABASE_URL=mysql+pymysql://localjob:localjob@127.0.0.1:3306/localjob?charset=utf8mb4

# SQLite fallback file
SQLITE_FILE=localjob.sqlite3

# Auth
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_TTL_DAYS=30

# Product
DEFAULT_LANGUAGE=uz
SEED_DEMO_DATA=1
